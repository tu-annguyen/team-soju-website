{
  "name": "@team-soju/api-server",
  "description": "Backend API for Team Soju website",
  "version": "1.0.0",
  "private": true,
  "main": "src/cloudflare/worker-entry.mjs",
  "scripts": {
    "start": "npm run dev:worker",
    "dev": "npm run dev:worker",
    "export:d1": "node src/scripts/export-postgres-to-d1.js",
    "dev:worker": "wrangler dev --local --config wrangler.jsonc --env-file ../../.env --inspector-port 9230",
    "dev:worker:staging": "wrangler dev --local --config wrangler.jsonc --env staging --env-file ../../.env --inspector-port 9230",
    "deploy:cf": "wrangler deploy --config wrangler.jsonc --env=\"\"",
    "deploy:cf:preview": "wrangler versions upload --config wrangler.jsonc",
    "deploy:cf:staging": "wrangler deploy --config wrangler.jsonc --env staging",
    "d1:schema": "npm run d1:schema:prod && npm run d1:schema:staging",
    "d1:schema:prod": "wrangler d1 execute DB --config wrangler.jsonc --remote --file=src/cloudflare/schema.d1.sql",
    "d1:schema:staging": "wrangler d1 execute DB --config wrangler.jsonc --env staging --remote --file=src/cloudflare/schema.d1.sql",
    "d1:migrate:prod": "wrangler d1 migrations apply DB --config wrangler.jsonc --remote",
    "d1:migrate:staging": "wrangler d1 migrations apply DB --config wrangler.jsonc --env staging --remote",
    "d1:migrate:local": "wrangler d1 migrations apply DB --config wrangler.jsonc --local",
    "import:shiny-war-dex": "node src/scripts/import-shiny-war-dex.js",
    "tail:cf": "wrangler tail --config wrangler.jsonc --format pretty",
    "tail:cf:staging": "wrangler tail --config wrangler.jsonc --env staging --format pretty",
    "test": "jest --runInBand --coverage"
  },
  "dependencies": {
    "@team-soju/utils": "^1.0.0",
    "dotenv": "^16.3.1",
    "joi": "^17.11.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.11.3"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "wrangler": "^4.75.0"
  }
}
