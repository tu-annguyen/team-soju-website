{
  "name": "@team-soju/discord-bot",
  "version": "1.0.0",
  "description": "Discord bot for Team Soju - manages team members and shiny Pokemon",
  "main": "src/worker.js",
  "scripts": {
    "dev": "wrangler dev --local --config wrangler.jsonc --env-file ../../.env --inspector-port 9231",
    "dev:local": "wrangler dev --local --config wrangler.jsonc --env-file ../../.env --var SCREENSHOT_RESULT_CALLBACK_URL:http://localhost:8788/internal/screenshot-result --port 8788 --inspector-port 9231",
    "dev:staging": "wrangler dev --local --config wrangler.jsonc --env staging --env-file ../../.env --inspector-port 9231",
    "dev:staging:local": "wrangler dev --local --config wrangler.jsonc --env staging --env-file ../../.env --port 8788 --inspector-port 9231",
    "register": "node -e \"require('./src/worker').registerCommandsIfNeeded({ ...process.env, REGISTER_COMMANDS_ON_START: 'true' })\"",
    "deploy:cf": "wrangler deploy --config wrangler.jsonc --env=\"\" && npm run register",
    "deploy:cf:preview": "wrangler versions upload --config wrangler.jsonc",
    "deploy:cf:staging": "wrangler deploy --config wrangler.jsonc --env staging && npm run register",
    "deploy:cf:staging:preview": "wrangler versions upload --config wrangler.jsonc --env staging",
    "tail:cf": "wrangler tail --config wrangler.jsonc --format pretty",
    "tail:cf:staging": "wrangler tail --config wrangler.jsonc --env staging --format pretty",
    "test": "jest --runInBand --coverage"
  },
  "keywords": [
    "discord",
    "discord-bot",
    "slash-commands",
    "pokemon",
    "team-soju"
  ],
  "author": "Tu-An Nguyen",
  "license": "MIT",
  "dependencies": {
    "@team-soju/utils": "^1.0.0",
    "dotenv": "^16.3.1"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "cross-env": "^10.1.0",
    "jest": "^30.2.0",
    "wrangler": "^4.75.0"
  }
}
