---
import Layout from '../../../layouts/Layout.astro';
import EventsHeader from '../../../components/EventsHeader';
import ShinyWar from '../../../components/ShinyWar';
const apiBaseUrl = import.meta.env.PUBLIC_API_BASE_URL || 'http://localhost:8787/api';
---

<Layout 
  title="Shiny Wars 2026 - Team Soju"
  description="Follow Team Soju's Shiny Wars 2026 points, standings, species coverage, and recent catches."
>
  <EventsHeader client:load />
  <ShinyWar client:load apiBaseUrl={apiBaseUrl} />
</Layout>
