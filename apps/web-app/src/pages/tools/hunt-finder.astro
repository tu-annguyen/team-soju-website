---
import Layout from '../../layouts/Layout.astro';
import HuntFinder from '../../components/shiny-war/HuntFinder';

const apiBaseUrl = import.meta.env.PUBLIC_API_BASE_URL || 'http://localhost:8787/api';
---

<Layout
  title="PokeMMO Hunt Finder - Team Soju"
  description="Compare PokeMMO encounter locations by shiny points, experience, levels, and EV yields."
>
  <section class="bg-gradient-to-br from-primary-50 to-secondary-50 py-14 dark:from-gray-900 dark:to-gray-800">
    <div class="container">
      <p class="text-sm font-semibold uppercase tracking-[0.25em] text-primary-700 dark:text-primary-300">Public PokeMMO Tool</p>
      <h1 class="mt-3 text-4xl font-bold text-gray-950 dark:text-white md:text-5xl">Hunt Finder</h1>
      <p class="mt-4 max-w-3xl text-gray-700 dark:text-gray-300">
        Find and compare wild encounters by location, species, level, EV yield, shiny points, or estimated EXP per hour.
      </p>
    </div>
  </section>
  <section class="py-10">
    <div class="container">
      <HuntFinder client:load apiBaseUrl={apiBaseUrl} context="public" />
    </div>
  </section>
</Layout>
